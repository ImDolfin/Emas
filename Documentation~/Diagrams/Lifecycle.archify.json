  "cards": [
    {
      "dot": "cyan",
      "title": "Optional presentation",
      "items": [
        "Manifest retains a request; a View needs an available root, prefab and usable presentation.",
        "Range suppression retains the request. Demanifest cancels it and removes only the View."
      ]
    },
    {
      "dot": "amber",
      "title": "Loss and recovery",
      "items": [
        "Grace or startup handover can retain an unavailable root until detection and finalization.",
        "Detector failure removes its population; recovery creates new roots. Final removal applies from any state."
      ]
    }
