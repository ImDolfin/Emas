  "cards": [
    {
      "dot": "cyan",
      "title": "Ownership and availability",
      "items": [
        "Realm owns anchors and one identity per Anchor + Kind + ID; SDK clients remain application-owned.",
        "Queries match available root contracts; optional views do not define availability."
      ]
    },
    {
      "dot": "emerald",
      "title": "WGS84 to Unity",
      "items": [
        "GeoPosition uses degrees and ellipsoidal metres; Spatial stores ECEF doubles.",
        "After all readers and Ghost hooks, capture one manual/followed reference and project into Unity east/up/north."
      ]
    },
    {
      "dot": "violet",
      "title": "Presentation and recovery",
      "items": [
        "Manifest requests a view; geographic/reference waiting and range suppression retain that request.",
        "Reference loss freezes its last valid pose. Demanifest cancels the view request; grace can retain a disappeared root."
      ]
    }
  ]
